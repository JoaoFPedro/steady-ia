{
  "project": {
    "name": "Steady"
  },
  "security_priority": "high",
  "stack": {
    "language": "typescript/csharp",
    "framework": "expo-react-native/dotnet",
    "test_runner": ["jest", "xunit"],
    "database": ["postgresql"],
    "ui_library": "react-native",
    "orm": "entity-framework-core",
    "package_manager": "npm",
    "monorepo": true
  },
  "conventions": {
    "branch_pattern": "{type}/{story-id}-{descricao}",
    "commit_format": "conventional",
    "story_id_format": "STORY-{NNN}",
    "adr_id_format": "ADR-{NNN}"
  },
  "extensions": {
    "ddd": true,
    "contract_testing": false,
    "compliance": true
  },
  "mcps": {
    "git": true,
    "context7": true,
    "markitdown": true,
    "playwright": false,
    "sonar": false,
    "dbhub": true
  }
}
