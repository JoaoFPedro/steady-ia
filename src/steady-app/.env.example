# Copie para `.env` e preencha. O `.env` real não vai para o git.
#
# Client ID do tipo Web (Google Cloud → Credenciais). Não é segredo — o que
# nunca pode ir para o git é client secret, e este fluxo não usa nenhum.
# Precisa ser idêntico ao Google__ClientId da API (ADR-002).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=SEU-CLIENT-ID.apps.googleusercontent.com

# IP da máquina na rede local (`hostname -I`), nunca `localhost`: no celular,
# `localhost` é o próprio aparelho.
EXPO_PUBLIC_API_URL=http://SEU-IP-LOCAL:5050
